<%= render Components::Page.new() do %>
  <div class="w-sm mx-auto">
    <%= render Components::Box.new() do %>
      <%= render Components::BoxContent.new() do %>
        <h2 class="mb-4">Log in</h2>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), builder: RubyUiFormBuilder) do |f| %>
          <div class="flex flex-col gap-4 mb-4">
            <%= render RubyUI::FormField.new do %>
              <p><%= f.label :email %></p>
              <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
            <% end %>

            <%= render RubyUI::FormField.new do %>
              <p><%= f.label :password %></p>
              <p><%= f.password_field :password, autocomplete: "current-password" %></p>
            <% end %>

            <% if devise_mapping.rememberable? %>
              <%= render RubyUI::FormField.new do %>
                <div class="flex items-center space-x-3">
                  <%= f.check_box :remember_me %>
                  <%= f.label :remember_me %>
                </div>
              <% end %>
            <% end %>
          </div>

          <div class="actions mb-4">
            <%= f.submit "Log in" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      <% end %>
    <% end %>
  </div>
<% end %>
