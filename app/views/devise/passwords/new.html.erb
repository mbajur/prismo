<%= render Components::Page.new() do %>
  <div class="w-sm mx-auto">
    <%= render Components::Box.new() do %>
      <%= render Components::BoxContent.new() do %>
        <h2 class="mb-4">Forgot your password?</h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, builder: RubyUiFormBuilder) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="field mb-4">
            <p><%= f.label :email %></p>
            <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
          </div>

          <div class="actions mb-4">
            <%= f.submit "Send me password reset instructions", class: "w-full" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      <% end %>
    <% end %>
  </div>
<% end %>
